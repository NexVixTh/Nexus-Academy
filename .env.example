# Example configuration only. Never put real secrets in this file.
# Set values in the backend process environment; this application does not load .env automatically.
# All model tasks are disabled unless explicitly enabled.
NEXUS_MODEL_TIMEOUT_SECONDS=15
NEXUS_MODEL_MAX_RETRIES=0

# Provider keys: set the real value only in your local backend environment.
GROQ_API_KEY=replace-with-groq-api-key
OPENROUTER_API_KEY=replace-with-openrouter-api-key
GEMINI_API_KEY=replace-with-gemini-api-key
OPENAI_API_KEY=replace-with-openai-compatible-api-key-if-required

# Tutor answer route. Example model ID is operator-selected, not a recommendation.
NEXUS_TUTOR_ENABLED=false
NEXUS_TUTOR_PROVIDER=disabled
NEXUS_TUTOR_MODEL=replace-with-model-id
NEXUS_TUTOR_BASE_URL=
NEXUS_TUTOR_API_KEY=
NEXUS_TUTOR_MAX_TOKENS=700
NEXUS_TUTOR_CAPABILITIES=chat
NEXUS_TUTOR_FALLBACK_PROVIDER=disabled
NEXUS_TUTOR_FALLBACK_MODEL=
NEXUS_TUTOR_FALLBACK_BASE_URL=
NEXUS_TUTOR_FALLBACK_CAPABILITIES=chat

# Configurable task routes. Quiz generation and concept extraction are not connected yet.
NEXUS_QUIZ_ENABLED=false
NEXUS_QUIZ_PROVIDER=disabled
NEXUS_QUIZ_MODEL=replace-with-model-id
NEXUS_QUIZ_BASE_URL=
NEXUS_QUIZ_API_KEY=
NEXUS_QUIZ_MAX_TOKENS=1200
NEXUS_QUIZ_CAPABILITIES=chat
NEXUS_QUIZ_FALLBACK_PROVIDER=disabled
NEXUS_QUIZ_FALLBACK_MODEL=
NEXUS_QUIZ_FALLBACK_BASE_URL=
NEXUS_QUIZ_FALLBACK_CAPABILITIES=chat

NEXUS_CONCEPT_ENABLED=false
NEXUS_CONCEPT_PROVIDER=disabled
NEXUS_CONCEPT_MODEL=replace-with-model-id
NEXUS_CONCEPT_BASE_URL=
NEXUS_CONCEPT_API_KEY=
NEXUS_CONCEPT_MAX_TOKENS=1000
NEXUS_CONCEPT_CAPABILITIES=chat
NEXUS_CONCEPT_FALLBACK_PROVIDER=disabled
NEXUS_CONCEPT_FALLBACK_MODEL=
NEXUS_CONCEPT_FALLBACK_BASE_URL=
NEXUS_CONCEPT_FALLBACK_CAPABILITIES=chat

# Capability declarations must match the selected model. No images are sent automatically.
NEXUS_VISION_ENABLED=false
NEXUS_VISION_PROVIDER=disabled
NEXUS_VISION_MODEL=replace-with-vision-model-id
NEXUS_VISION_BASE_URL=
NEXUS_VISION_API_KEY=
NEXUS_VISION_MAX_TOKENS=1000
NEXUS_VISION_CAPABILITIES=chat,vision
NEXUS_VISION_FALLBACK_PROVIDER=disabled
NEXUS_VISION_FALLBACK_MODEL=
NEXUS_VISION_FALLBACK_BASE_URL=
NEXUS_VISION_FALLBACK_CAPABILITIES=chat,vision

NEXUS_EMBEDDING_ENABLED=false
NEXUS_EMBEDDING_PROVIDER=disabled
NEXUS_EMBEDDING_MODEL=replace-with-embedding-model-id
NEXUS_EMBEDDING_BASE_URL=
NEXUS_EMBEDDING_API_KEY=
NEXUS_EMBEDDING_CAPABILITIES=embeddings
NEXUS_EMBEDDING_FALLBACK_PROVIDER=disabled
NEXUS_EMBEDDING_FALLBACK_MODEL=
NEXUS_EMBEDDING_FALLBACK_BASE_URL=
NEXUS_EMBEDDING_FALLBACK_CAPABILITIES=embeddings

NEXUS_VERIFICATION_ENABLED=false
NEXUS_VERIFICATION_PROVIDER=disabled
NEXUS_VERIFICATION_MODEL=replace-with-model-id
NEXUS_VERIFICATION_BASE_URL=
NEXUS_VERIFICATION_API_KEY=
NEXUS_VERIFICATION_MAX_TOKENS=500
NEXUS_VERIFICATION_CAPABILITIES=chat
NEXUS_VERIFICATION_FALLBACK_PROVIDER=disabled
NEXUS_VERIFICATION_FALLBACK_MODEL=
NEXUS_VERIFICATION_FALLBACK_BASE_URL=
NEXUS_VERIFICATION_FALLBACK_CAPABILITIES=chat
